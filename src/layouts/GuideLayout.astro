---
import '../styles/global.css';
import '../styles/refinement.css';
import ThemeToggle from '../components/ThemeToggle';

interface Props {
  title: string;
  description: string;
  canonicalPath: string;
  imagePath: string;
  imageAlt: string;
  breadcrumbLabel: string;
}

const { title, description, canonicalPath, imagePath, imageAlt, breadcrumbLabel } = Astro.props;
const siteRoot = new URL('/', Astro.site ?? 'https://textcompare.amosfot.in/').toString();
const canonicalUrl = new URL(canonicalPath, siteRoot).toString();
const ogImageUrl = new URL(imagePath, siteRoot).toString();
const structuredData = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'WebSite', '@id': siteRoot + '#website', url: siteRoot, name: 'Private Text Compare', inLanguage: 'en' },
    {
      '@type': 'WebPage',
      '@id': canonicalUrl + '#webpage',
      url: canonicalUrl,
      name: breadcrumbLabel,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': siteRoot + '#website' },
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Private Text Compare', item: siteRoot },
        { '@type': 'ListItem', position: 2, name: breadcrumbLabel, item: canonicalUrl },
      ],
    },
  ],
};
---
<!doctype html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} />
  <meta name="robots" content="index, follow, max-image-preview:large" />
  <meta name="generator" content={Astro.generator} />
  <link rel="canonical" href={canonicalUrl} />
  <meta property="og:type" content="article" />
  <meta property="og:site_name" content="Private Text Compare" />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:url" content={canonicalUrl} />
  <meta property="og:image" content={ogImageUrl} />
  <meta property="og:image:width" content="1200" />
  <meta property="og:image:height" content="630" />
  <meta property="og:image:alt" content={imageAlt} />
  <meta name="twitter:card" content="summary_large_image" />
  <meta name="twitter:title" content={title} />
  <meta name="twitter:description" content={description} />
  <meta name="twitter:image" content={ogImageUrl} />
  <meta name="twitter:image:alt" content={imageAlt} />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  <link rel="preload" href="/fonts/geist/geist-sans-variable.woff2" as="font" type="font/woff2" crossorigin />
  <link rel="preload" href="/fonts/geist/geist-mono-variable.woff2" as="font" type="font/woff2" crossorigin />
  <script type="application/ld+json" set:html={JSON.stringify(structuredData)}></script>
  <script is:inline>
    (() => { const key='private-text-compare-theme'; let theme='dark'; try { const saved=localStorage.getItem(key); if(saved==='light'||saved==='dark') theme=saved; else if(saved!==null) localStorage.removeItem(key); } catch {} document.documentElement.dataset.theme=theme; })();
  </script>
  <title>{title}</title>
</head>
<body>
  <main class="site-shell">
    <div class="page-frame guide-frame">
      <header class="site-header">
        <a href="/" class="brand-mark">Private Text Compare</a>
        <div class="header-actions"><span class="local-status">Guide</span><ThemeToggle client:load /></div>
      </header>
      <nav class="guide-breadcrumb" aria-label="Breadcrumb">
        <a href="/">Private Text Compare</a><span aria-hidden="true">/</span><span aria-current="page">{breadcrumbLabel}</span>
      </nav>
      <slot />
      <footer class="site-footer">
        <span>Private Text Compare · Browser-side text comparison</span>
        <nav class="portfolio-nav" aria-label="More Amosfot browser tools">
          <span class="portfolio-nav-label">More browser tools by Amosfot</span>
          <a href="https://upload-ready.amosfot.in/">Upload Ready</a>
          <a href="https://pdf-ready.amosfot.in/">PDF Ready</a>
        </nav>
      </footer>
    </div>
  </main>
</body>
</html>
