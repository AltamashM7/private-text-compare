---
import BaseLayout from '../layouts/BaseLayout.astro';
import TextCompareTool from '../components/TextCompareTool';
---

<BaseLayout
  title="Private Text Compare — Compare Text Online Privately"
  description="Compare two versions of text and see line-by-line and word-level changes directly in your browser."
>
  <div class="w-full">
    <header class="flex items-center justify-between gap-4 py-5 sm:py-6">
      <a href="/" class="text-sm font-bold tracking-tight text-slate-950 sm:text-base">Private Text Compare</a>
      <span class="rounded-full border border-emerald-200 bg-emerald-50 px-3 py-1.5 text-xs font-semibold text-emerald-900">
        Browser-only comparison
      </span>
    </header>

    <section class="pb-6 pt-3 sm:pb-8 sm:pt-6">
      <p class="text-sm font-semibold uppercase tracking-[0.16em] text-indigo-700">Private by design</p>
      <h1 class="mt-3 max-w-4xl text-3xl font-bold tracking-tight text-slate-950 sm:text-4xl lg:text-5xl">
        Private Text Compare
      </h1>
      <p class="mt-4 max-w-3xl text-lg leading-8 text-slate-700 sm:text-xl">
        Compare two versions of text and instantly see exactly what changed.
      </p>
      <p class="mt-2 max-w-2xl text-sm leading-6 text-slate-600">
        Everything stays in your browser. Nothing you compare is saved or sent anywhere by this tool.
      </p>
    </section>

    <TextCompareTool client:load />

    <footer class="py-8 text-center text-sm leading-6 text-slate-500 sm:py-10">
      Your text is processed locally in this page session and clears on refresh.
    </footer>
  </div>
</BaseLayout>
