---
import BaseLayout from '../layouts/BaseLayout.astro';
import TextCompareTool from '../components/TextCompareTool';
import ThemeToggle from '../components/ThemeToggle';
---

<BaseLayout
  title="Private Text Compare — Compare Text Online Privately"
  description="Compare two versions of text and see line-by-line and word-level changes directly in your browser."
>
  <div class="page-frame">
    <header class="site-header">
      <a href="/" class="brand-mark">Private Text Compare</a>
      <div class="header-actions">
        <span class="local-status" title="Your text never leaves this browser.">
          <span class="local-status-dot" aria-hidden="true"></span>
          Local only
        </span>
        <ThemeToggle client:load />
      </div>
    </header>

    <section class="product-intro" aria-labelledby="page-title">
      <p class="section-kicker">Private developer utility</p>
      <h1 id="page-title">Private Text Compare</h1>
      <p class="product-intro-lead">
        Compare text without sending it anywhere. See every line and word that changed.
      </p>
      <p class="privacy-line">No uploads · No account · No tracking</p>
    </section>

    <TextCompareTool client:load />

    <footer class="site-footer">
      Your text is processed locally in this page session and clears on refresh.
    </footer>
  </div>
</BaseLayout>
